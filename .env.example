# Copy to .env for local dev. Set these as Railway environment variables in production.

# Required — your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# Optional — set to "production" on Railway
ENVIRONMENT=development

# Reddit — OPTIONAL but strongly recommended for reliable Community section data.
# When REDDIT_CLIENT_ID + REDDIT_CLIENT_SECRET are set, the scraper uses
# application-only OAuth (60 req/min) instead of anonymous RSS, which is
# rate-limited on Railway datacenter IPs after the first request.
# Without these, a hardened anonymous-RSS fallback runs (5s spacing + 429 backoff),
# but may return fewer items in production.
#
# Create a Reddit app at https://www.reddit.com/prefs/apps (type: "script")
# REDDIT_USER_AGENT is optional; defaults to the built-in ArieFinance UA.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ArieFinance-MarketIntel/1.0 (by u/yourusername)
